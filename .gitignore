__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env
.ipynb_checkpoints/
.vscode/
.ruff_cache/
*.egg-info/
build/

# kagglehub leaves a download marker next to the files it fetches.
data/**/.complete/

# Interim and processed data are regenerated by make features; only raw data is committed.
data/interim/*
data/processed/*
!data/interim/.gitkeep
!data/processed/.gitkeep
